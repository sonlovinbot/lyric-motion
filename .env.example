# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is git-ignored. Keys stay on your machine: the browser talks to server.py, server.py talks to the APIs.

# Groq (speech-to-text with Whisper) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# DeepSeek (fixes the transcript: spelling, diacritics, line breaks) — https://platform.deepseek.com/api_keys
# Optional: without it you get the raw Whisper lines.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# TypeSafe (Jev picks layouts / entrances / exits that match each line) — https://typesafe.ai
# Optional: without it the "AI chọn hiệu ứng" panel is disabled and effects stay seeded-random.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Default transcription language (ISO 639-1, e.g. vi, en, ja). Empty = auto-detect.
TRANSCRIBE_LANGUAGE=vi

PORT=8765
